# Required engine config
GCP_PROJECT=
GOOGLE_OAUTH_CLIENT_ID=
ALLOWED_DOMAIN=

# Optional: the gateway's origin. Act-as connect verbs derive the connect page
# and the redirect URI they accept from it (docs/remote-mcp.md §4.8). Empty
# disables connecting an upstream account.
# CHARTER_GATEWAY_URL=

# Optional: resource names (defaults shown)
# KEYS_SECRET_NAME=charter-keys
# GOOGLE_REFRESH_SECRET_NAME=charter-google-refresh
# AUDIT_TABLE=charter.audit

# Optional: pack config
# WAREHOUSE_DATASETS=
# PACKS=

# Optional: pack-scoped secrets (SecretStr, never logged)
# PERSONAL_ACCESS_TOKEN=
# POSTHOG_API_KEY=
# DROPBOXSIGN_TOKEN=
# DROPBOXSIGN_TEMPLATE_ID=
# TEST_MODE=
# TEST_MODE_EMAIL=
